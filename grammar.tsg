// Assembly grammar for tree-sitter (native DSL).
// Translated from grammar.js.

macro sep(separator: rule_t, rule: rule_t) rule_t {
    optional(seq(rule, repeat(seq(separator, rule)), optional(separator)))
}

macro tc_binop(p: int_t, op: str_t) rule_t {
    prec_left(p, seq(field(lhs, _tc_expr), field(op, op), field(rhs, _tc_expr)))
}

let INT_PATTERN: rule_t = regexp(r"-?([0-9][0-9_]*|(0x|\$)[0-9A-Fa-f][0-9A-Fa-f_]*|0b[01][01_]*)")

grammar {
    language: "asm",
    extras: [regexp(r" |\t|\r"), line_comment, block_comment],
    conflicts: [[_expr, _tc_expr]],
}

rule program { sep(repeat1("\n"), _item) }

rule _item { choice(meta, label, const, instruction) }

rule meta {
    seq(
        field(kind, meta_ident),
        optional(choice(
            ident,
            seq(int, repeat(seq(",", int))),
            seq(float, repeat(seq(",", float))),
            seq(string, repeat(seq(",", string))),
        )),
    )
}

rule label {
    choice(
        seq(
            choice(meta_ident, alias(word, ident), alias(_ident, ident)),
            ":",
            optional(choice(seq("(", ident, ")"), meta)),
        ),
        seq("label", field(name, word)),
    )
}

rule const {
    seq("const", field(name, word), field(value, _tc_expr))
}

rule instruction {
    seq(field(kind, word), choice(sep(",", _expr), repeat(_tc_expr)))
}

rule _expr { choice(ptr, ident, int, string, float, list) }

// ARMv7
rule list {
    seq(
        "{",
        optional(seq(reg, repeat(seq(choice(",", "-"), reg)), optional(","))),
        "}",
    )
}

rule ptr {
    choice(
        seq(
            optional(seq(choice("byte", "word", "dword", "qword"), "ptr")),
            "[", reg,
            optional(seq(choice("+", "-"), choice(int, ident))),
            "]",
        ),
        seq(optional(int), "(", reg, ")"),
        seq("*", "rel", "[", int, "]"),
        // Aarch64
        seq("[", reg, optional(seq(",", int)), "]", optional("!")),
    )
}

// Turing Complete
rule _tc_expr { choice(ident, int, string, tc_infix) }

rule tc_infix {
    choice(
        tc_binop(0, "+"),
        tc_binop(0, "-"),
        tc_binop(1, "*"),
        tc_binop(1, "/"),
        tc_binop(1, "%"),
        tc_binop(2, "|"),
        tc_binop(3, "^"),
        tc_binop(4, "&"),
    )
}

rule int { choice(seq("#", token_immediate(INT_PATTERN)), INT_PATTERN) }

rule float { regexp(r"-?[0-9][0-9_]*\.([0-9][0-9_]*)?") }

rule string {
    choice(regexp(r#""[^"]*""#), regexp(r"'[^']*'"))
}

rule word { regexp(r"[a-zA-Z0-9_]+") }
rule _reg { regexp(r"%?[a-z0-9]+") }
rule address { regexp(r"[=\$][a-zA-Z0-9_]+") }
rule reg { choice(_reg, word, address) }
rule meta_ident { regexp(r"\.[a-z_]+") }
rule _ident { regexp(r"[a-zA-Z_0-9.]+") }
rule ident { choice(_ident, meta_ident, reg) }

rule line_comment {
    choice(
        seq("#", token_immediate(regexp(r".*"))),
        regexp(r"(\/\/|;).*"),
    )
}

rule block_comment {
    token(seq("/*", regexp(r"[^*]*\*+([^/*][^*]*\*+)*"), "/"))
}
